# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible Chat Completions endpoint (OpenAI, Azure OpenAI compatible proxy, CLIProxyAPI, ...)
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_API_KEY=<your API key>
OPENAI_MODEL=<model id>

# Optional: CLIProxyAPI management key, used by the admin "Token" tab to show account quotas.
# Leave empty to hide quotas.
CLIPROXY_MANAGEMENT_KEY=

# Microsoft sign-in: an App registration in Microsoft Entra ID (single tenant)
AzureAd__TenantId=<Directory (tenant) ID>
AzureAd__ClientId=<Application (client) ID>
AzureAd__ClientSecret=<client secret value>

# Admin accounts (sign-in emails). Add more with Admins__1, Admins__2, ...
# Admins__0=you@example.com

# false = disable sign-in (e.g. no HTTPS yet): every browser is an anonymous guest and everyone is an admin.
# Only use on a trusted network.
# Auth__Enabled=false

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" Version="1.23.0-preview.260928.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
  </ItemGroup>

  <!-- The DevUI package mistakenly ships an index.html at "/" that clashes with wwwroot/index.html. The real DevUI runs from embedded resources, so drop this file -->
  <ItemGroup>
    <StaticWebAsset Remove="$(NuGetPackageRoot)microsoft.agents.ai.devui/**/index.html" />
  </ItemGroup>

</Project>
